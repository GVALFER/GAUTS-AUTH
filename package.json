{
    "name": "@gauts/auth",
    "version": "0.10.3",
    "description": "Secure authentication for Node.js applications, with password login, persistent sessions, social providers, and adapters for popular frameworks and databases.",
    "license": "MIT",
    "author": "GVALFER",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GVALFER/GAUTS-AUTH.git"
    },
    "homepage": "https://github.com/GVALFER/GAUTS-AUTH#readme",
    "bugs": {
        "url": "https://github.com/GVALFER/GAUTS-AUTH/issues"
    },
    "keywords": [
        "authentication",
        "argon2",
        "bcrypt",
        "drizzle",
        "express",
        "fastify",
        "hono",
        "mariadb",
        "mysql",
        "nextjs",
        "oauth",
        "session"
    ],
    "type": "module",
    "packageManager": "npm@11.17.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "files": [
        "dist",
        "src/adapters/drizzle/schema.ts",
        "src/adapters/prisma/schema.prisma",
        "LICENSE",
        "README.md",
        "SECURITY.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./prisma": {
            "types": "./dist/adapters/prisma/index.d.ts",
            "import": "./dist/adapters/prisma/index.js"
        },
        "./drizzle": {
            "types": "./dist/adapters/drizzle/index.d.ts",
            "import": "./dist/adapters/drizzle/index.js"
        },
        "./express": {
            "types": "./dist/adapters/express/index.d.ts",
            "import": "./dist/adapters/express/index.js"
        },
        "./fastify": {
            "types": "./dist/adapters/fastify/index.d.ts",
            "import": "./dist/adapters/fastify/index.js"
        },
        "./hono": {
            "types": "./dist/adapters/hono/index.d.ts",
            "import": "./dist/adapters/hono/index.js"
        },
        "./next": {
            "types": "./dist/adapters/next/index.d.ts",
            "import": "./dist/adapters/next/index.js"
        },
        "./headers": {
            "types": "./dist/headers/index.d.ts",
            "import": "./dist/headers/index.js"
        },
        "./providers": {
            "types": "./dist/providers/index.d.ts",
            "import": "./dist/providers/index.js"
        }
    },
    "scripts": {
        "clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { force: true, recursive: true })\"",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "typecheck:examples": "npm run build && tsc -p examples/drizzle/tsconfig.json && tsc -p examples/express/tsconfig.json && tsc -p examples/fastify/tsconfig.json && tsc -p examples/hono/tsconfig.json && tsc -p examples/next/tsconfig.json",
        "lint": "eslint src tests examples",
        "test": "node --import tsx --test tests/**/*.test.ts",
        "check": "npm run build && npm run lint && npm run typecheck && npm test",
        "prepack": "npm run check"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "argon2": "^0.45.1",
        "bcryptjs": "^3.0.2",
        "cookie": "^2.0.1"
    },
    "peerDependencies": {
        "drizzle-orm": "^0.45.2",
        "express": "^5.0.0",
        "fastify": "^5.0.0",
        "hono": "^4.13.0",
        "next": ">=15.0.0"
    },
    "peerDependenciesMeta": {
        "drizzle-orm": {
            "optional": true
        },
        "express": {
            "optional": true
        },
        "fastify": {
            "optional": true
        },
        "hono": {
            "optional": true
        },
        "next": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/express": "^5.0.6",
        "@types/node": "^24.10.0",
        "drizzle-orm": "^0.45.2",
        "eslint": "^9.39.5",
        "express": "^5.2.1",
        "fastify": "^5.12.1",
        "globals": "^16.5.0",
        "hono": "^4.13.0",
        "mysql2": "^3.23.3",
        "next": "^16.2.12",
        "tsx": "^4.23.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0"
    },
    "allowScripts": {
        "argon2@0.45.1": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    }
}
